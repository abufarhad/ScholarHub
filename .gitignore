# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated from prisma/data/scholarhub.db by scripts/export-static-data.ts —
# the SQLite file is the source of truth, this is a derived build artifact
/public/data/*.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# AI coding tool scaffolding (skill docs, launch config) — not project source
/.agents/
/.claude/
/.windsurf/
/.idea/
/skills-lock.json
